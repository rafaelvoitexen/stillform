---
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Archive from '../components/Archive.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GlobalPointer from '../components/GlobalPointer.astro';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import critical from '../styles/hero-critical.css?raw';
import admission from '../scripts/hero-admission.js?raw';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="STILLFORM — An archive of spatial observations. Built around absence." />
    <link rel="preload" href="/fonts/Onest-Latin-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/images/tulach-e-vos.jpg" as="image" fetchpriority="high" />
    <style is:inline>
@font-face {
  font-family: Onest;
  src: url('/fonts/Onest-Latin-Variable.woff2') format('woff2');
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
}
    </style>
    <style is:inline set:html={critical}></style>
    <script is:inline set:html={admission}></script>
    <title>STILLFORM — Built around absence.</title>
  </head>
  <body><div class="page"><Hero /><Manifesto /><Archive /></div><SiteHeader /><SiteFooter /><GlobalPointer /><script>import '../scripts/chapter-transition'; import '../scripts/smooth-scroll';</script></body>
</html>
